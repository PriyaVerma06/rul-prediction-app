# ==============================================================================
# RUL Prediction API Configuration
# ==============================================================================

# Application logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Model version identifier
MODEL_VERSION=1.0.0-cmapss-gru

# Health status classification thresholds (in remaining cycles)
# Predicted RUL <= HEALTH_THRESHOLD_CRITICAL -> "critical"
# HEALTH_THRESHOLD_CRITICAL < Predicted RUL <= HEALTH_THRESHOLD_WARNING -> "warning"
# Predicted RUL > HEALTH_THRESHOLD_WARNING -> "healthy"
HEALTH_THRESHOLD_CRITICAL=30.0
HEALTH_THRESHOLD_WARNING=75.0

# Maximum batch size allowed for /predict/batch endpoint
MAX_BATCH_SIZE=32

# CORS allowed origins (comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional custom artifacts directory path (defaults to backend/artifacts if unset)
# ARTIFACTS_DIR=/path/to/custom/artifacts

